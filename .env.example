# Unnet runs fully offline by default using the recorded cassettes in
# data/cassettes/, so none of this is required to reproduce the published
# metrics. Set a key only if you want the agents to call a live model.

# Provider: gemini | groq | offline   (default: offline)
UNNET_LLM_PROVIDER=offline

# https://aistudio.google.com/apikey  — free tier
GEMINI_API_KEY=
UNNET_GEMINI_MODEL=gemini-2.0-flash

# https://console.groq.com/keys  — free tier, used as the fallback
GROQ_API_KEY=
UNNET_GROQ_MODEL=llama-3.3-70b-versatile

# Record live responses into data/cassettes/ so a later run can replay offline.
UNNET_LLM_RECORD=0

# Optional: read a real settlement recon report from Razorpay test mode instead
# of the synthetic fixtures. See unnet/ingest/razorpay_live.py.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
